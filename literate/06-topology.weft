\chapter{Topology}

Recognition works on the shape of the rope, not on its pose. Three steps make
that possible. The rope is closed, projected, and read as a knot diagram. Then
one invariant is computed from the diagram. The determinant is the simplest, and
it is the only one stage one uses.

\section{Closure}

A rope has two free ends, and a knot needs a closed loop. The ends are joined by
a straight segment, from the last link back to the first, and the loop is read
from there. The segment is part of the diagram like any other piece of rope.

The first closure joined the ends through a point far behind the background. It
was dropped. Its path runs straight back from each end, so whether a strand of the
rope lay in that path depended on how the rope was turned. Over 200 random turns
of a trefoil, it misread 49 of them as an unknot. The straight segment misread
none. Over 400 turns of a trefoil with open ends, the straight segment misread
none. It also does not depend on the view.

\section{Crossings and the Fox matrix}

The viewer looks down the depth axis, so the diagram is the rope's projection
onto the x and y plane. Two segments that cross in that plane form a crossing.
The one with the greater depth is over. Depth is compared at the crossing point
itself, not at the segment ends.

Every crossing has one under-passage, which splits the under-strand into arcs.
Walking along the loop, arc $j$ runs from under-passage $j$ to under-passage
$j+1$. Each crossing touches three arcs: the arc entering its under-passage, the
arc leaving it, and the arc that holds the over-strand. Fox colouring says that
for every crossing, twice the over colour minus the two under colours is zero
modulo the determinant. The coefficients of that condition form one row of the
Fox matrix, and the determinant is read from that matrix.

@d Topology: crossings and Fox matrix @{
import type { Vec3 } from '../rope/snapshot';

const EPS = 1e-12;

// One crossing of the projected diagram. The over strand passes above the under strand.
// A passage is a component, a segment of that component, and a fraction along the segment.
export interface Crossing {
  overComponent: number;
  overSegment: number;
  overAt: number;
  underComponent: number;
  underSegment: number;
  underAt: number;
  // The handedness of the crossing, from the directions of its two strands in the view.
  sign: 1 | -1;
}

// A diagram of closed components, seen down the z axis.
export interface Diagram {
  components: number;
  crossings: Crossing[];
  // How many under-passages each component has. Each one cuts the component into arcs.
  underCount: number[];
}

// Where segment a-b meets segment c-d in the view, as fractions along each, or null.
// Parallel or degenerate segments never meet.
function meet(a: Vec3, b: Vec3, c: Vec3, d: Vec3): { s: number; u: number } | null {
  const rx = b.x - a.x;
  const ry = b.y - a.y;
  const wx = d.x - c.x;
  const wy = d.y - c.y;
  const denom = rx * wy - ry * wx;
  if (Math.abs(denom) < EPS) return null;
  const qx = c.x - a.x;
  const qy = c.y - a.y;
  const s = (qx * wy - qy * wx) / denom;
  const u = (qx * ry - qy * rx) / denom;
  if (s < 0 || s >= 1 || u < 0 || u >= 1) return null;
  return { s, u };
}

// The crossings of closed components. A component is a list of points, and its last
// point joins back to its first. Segments of one component that touch are skipped.
export function diagramOf(components: readonly (readonly Vec3[])[]): Diagram {
  const crossings: Crossing[] = [];
  for (let ci = 0; ci < components.length; ci++) {
    for (let cj = ci; cj < components.length; cj++) {
      const a = components[ci];
      const b = components[cj];
      for (let i = 0; i < a.length; i++) {
        const start = ci === cj ? i + 2 : 0;
        for (let j = start; j < b.length; j++) {
          if (ci === cj && i === 0 && j === b.length - 1) continue; // these two share a vertex
          const p = a[i];
          const q = a[(i + 1) % a.length];
          const r = b[j];
          const s = b[(j + 1) % b.length];
          const hit = meet(p, q, r, s);
          if (!hit) continue;
          const depthI = p.z + hit.s * (q.z - p.z);
          const depthJ = r.z + hit.u * (s.z - r.z);
          const first = { component: ci, segment: i, at: hit.s, dx: q.x - p.x, dy: q.y - p.y };
          const second = { component: cj, segment: j, at: hit.u, dx: s.x - r.x, dy: s.y - r.y };
          const [over, under] = depthI > depthJ ? [first, second] : [second, first];
          crossings.push({
            overComponent: over.component,
            overSegment: over.segment,
            overAt: over.at,
            underComponent: under.component,
            underSegment: under.segment,
            underAt: under.at,
            sign: over.dx * under.dy - over.dy * under.dx > 0 ? 1 : -1,
          });
        }
      }
    }
  }
  const underCount = components.map(() => 0);
  for (const c of crossings) underCount[c.underComponent] += 1;
  return { components: components.length, crossings, underCount };
}

// The Wirtinger relation at one crossing. Arcs are numbered component by component:
// arc base[c] + k is the k-th arc of component c, from one under-passage to the next.
export interface Relation {
  overArc: number;
  inArc: number;
  outArc: number;
  sign: 1 | -1;
}

export function relationsOf(diagram: Diagram): Relation[] {
  const base: number[] = [];
  let total = 0;
  for (const u of diagram.underCount) {
    base.push(total);
    total += u;
  }
  // The rank of each crossing's under-passage among the under-passages of its component.
  const rank = new Array<number>(diagram.crossings.length).fill(0);
  for (let c = 0; c < diagram.components; c++) {
    diagram.crossings
      .map((x, index) => ({ index, position: x.underSegment + x.underAt, component: x.underComponent }))
      .filter((x) => x.component === c)
      .sort((p, q) => p.position - q.position)
      .forEach((x, k) => {
        rank[x.index] = k;
      });
  }
  // The arc of component c that holds a position: the last under-passage at or before it.
  const arcAt = (c: number, position: number): number => {
    const u = diagram.underCount[c];
    if (u === 0) throw new Error('a component with no under-passage is split from the rest');
    const passed = diagram.crossings.filter(
      (x) => x.underComponent === c && x.underSegment + x.underAt <= position,
    ).length;
    return base[c] + ((passed - 1 + u) % u);
  };
  return diagram.crossings.map((x, index) => {
    const u = diagram.underCount[x.underComponent];
    const k = rank[index];
    const start = base[x.underComponent];
    return {
      overArc: arcAt(x.overComponent, x.overSegment + x.overAt),
      inArc: start + ((k - 1 + u) % u),
      outArc: start + (k % u),
      sign: x.sign,
    };
  });
}

// The Fox colouring matrix: one row per crossing, one column per arc. Each row sums to zero.
export function foxMatrix(diagram: Diagram): number[][] {
  const arcs = diagram.crossings.length; // every arc starts at an under-passage
  const matrix = diagram.crossings.map(() => new Array<number>(arcs).fill(0));
  relationsOf(diagram).forEach((rel, row) => {
    matrix[row][rel.inArc] -= 1;
    matrix[row][rel.outArc] -= 1;
    matrix[row][rel.overArc] += 2;
  });
  return matrix;
}
@}

\section{Determinant}

The determinant of a knot is the absolute value of any one minor of the Fox
matrix, the matrix with one row and one column removed. The integer determinant
is computed exactly with the Bareiss method, which divides only where the result
is known to be whole. A rope with no crossings has the empty matrix, whose
determinant is one, which is the unknot's value.

@d Topology: determinant @{
import { foxMatrix, type Diagram } from './crossings';

// Exact integer determinant by the Bareiss method. The empty matrix has determinant one.
export function bareiss(input: readonly (readonly number[])[]): number {
  const m = input.map((row) => [...row]);
  const n = m.length;
  let sign = 1;
  let previous = 1;
  for (let k = 0; k < n - 1; k++) {
    if (m[k][k] === 0) {
      const swap = m.findIndex((row, i) => i > k && row[k] !== 0);
      if (swap === -1) return 0;
      [m[k], m[swap]] = [m[swap], m[k]];
      sign = -sign;
    }
    for (let i = k + 1; i < n; i++) {
      for (let j = k + 1; j < n; j++) {
        m[i][j] = (m[i][j] * m[k][k] - m[i][k] * m[k][j]) / previous;
      }
    }
    previous = m[k][k];
  }
  return n === 0 ? 1 : sign * m[n - 1][n - 1];
}

// The determinant of a diagram of knots or links: the absolute value of the Fox matrix
// with its last row and column removed. A link with a component that is never under
// another is split, and its determinant is zero.
export function linkDeterminant(diagram: Diagram): number {
  if (diagram.components > 1 && diagram.underCount.some((u) => u === 0)) return 0;
  const matrix = foxMatrix(diagram);
  const k = matrix.length;
  const minor = matrix.slice(0, k - 1).map((row) => row.slice(0, k - 1));
  return Math.abs(bareiss(minor));
}
@}

\section{Recogniser}

The recogniser closes the rope, builds the Fox matrix, takes the determinant, and
looks the value up in the library. The library has two entries in stage one. A
determinant that matches no entry gives no name, which is the honest answer
until the library grows. It does not guess.

The recogniser reads a snapshot and changes nothing. It is a pure function, so
the page can call it whenever the rope has moved.

@d Topology: recogniser @{
import type { RopeSnapshot, Vec3 } from '../rope/snapshot';
import { alexanderOf, samePolynomial } from './alexander';
import { diagramOf } from './crossings';
import { linkDeterminant } from './determinant';
import { LIBRARY, LINKS } from './library';

export interface AnchorResult {
  name: string | null;
  determinant: number;
}

export interface KnotResult {
  name: string | null;
  determinant: number;
  alexander: number[];
  crossings: number;
  anchors: AnchorResult[];
}

// Recognises the rope's knot, and each anchor's link with the rope. The rope is closed by a
// straight segment from its last link to its first. That segment is implicit in the loop.
export function recognise(snapshot: RopeSnapshot, anchors: readonly (readonly Vec3[])[] = []): KnotResult {
  const rope = diagramOf([snapshot.points]);
  const determinant = linkDeterminant(rope);
  const alexander = alexanderOf(rope);
  const known = LIBRARY.find((e) => e.determinant === determinant && samePolynomial(e.alexander, alexander));
  const linked = anchors.map((shape) => {
    const d = linkDeterminant(diagramOf([snapshot.points, shape]));
    const hit = d === 0 ? undefined : LINKS.find((e) => e.determinant === d);
    return { name: hit?.name ?? null, determinant: d };
  });
  return {
    name: known?.name ?? null,
    determinant,
    alexander,
    crossings: rope.crossings.length,
    anchors: linked,
  };
}
@}

\section{Tests}

The tests check the algorithm on shapes whose answers are known. A straight
rope and a rope with one curl are unknots. The standard trefoil curve is a
trefoil, and so is its mirror image, because the determinant cannot tell a knot
from its mirror. The Fox matrix of a two-by-two case gives a determinant of
three, which checks the exact arithmetic itself.

@d Topology: tests @{
import { describe, expect, it } from 'vitest';
import type { Vec3 } from '../rope/snapshot';
import { bareiss } from './determinant';
import { recognise } from './recogniser';

const SAMPLES = 120;

// Sample a closed curve at evenly spaced parameter values.
function sample(curve: (t: number) => Vec3): Vec3[] {
  return Array.from({ length: SAMPLES }, (_, i) => curve((2 * Math.PI * i) / SAMPLES));
}

const trefoil = (t: number): Vec3 => ({
  x: Math.sin(t) + 2 * Math.sin(2 * t),
  y: Math.cos(t) - 2 * Math.cos(2 * t),
  z: -Math.sin(3 * t),
});

const mirroredTrefoil = (t: number): Vec3 => ({ ...trefoil(t), z: -trefoil(t).z });

// A limacon, which crosses itself once in the view. Its depth makes one strand pass over the other.
const curl = (t: number): Vec3 => {
  const r = 0.5 + Math.cos(t);
  return { x: r * Math.cos(t), y: r * Math.sin(t), z: 0.2 * Math.sin(t) };
};

// Turn a point about the x axis by a, then the y axis by b, then the z axis by c.
function turn(p: Vec3, a: number, b: number, c: number): Vec3 {
  const y1 = p.y * Math.cos(a) - p.z * Math.sin(a);
  const z1 = p.y * Math.sin(a) + p.z * Math.cos(a);
  const x2 = p.x * Math.cos(b) + z1 * Math.sin(b);
  const z2 = -p.x * Math.sin(b) + z1 * Math.cos(b);
  return { x: x2 * Math.cos(c) - y1 * Math.sin(c), y: x2 * Math.sin(c) + y1 * Math.cos(c), z: z2 };
}

describe('determinant', () => {
  it('computes exact determinants of small integer matrices', () => {
    expect(bareiss([[2, -1], [-1, 2]])).toBe(3);
    expect(bareiss([[1, 0, 0], [0, 1, 0], [0, 0, 1]])).toBe(1);
    expect(bareiss([[0, 1], [1, 0]])).toBe(-1);
    expect(bareiss([])).toBe(1);
  });
});

describe('recogniser', () => {
  it('names a straight rope as the unknot', () => {
    const points = Array.from({ length: 40 }, (_, i) => ({ x: i * 0.05, y: 0, z: 0 }));
    const result = recognise({ points, radius: 0.02 });
    expect(result.name).toBe('unknot');
    expect(result.crossings).toBe(0);
  });

  it('names a rope with one curl as the unknot', () => {
    const result = recognise({ points: sample(curl), radius: 0.02 });
    expect(result.name).toBe('unknot');
    expect(result.determinant).toBe(1);
  });

  it('names the trefoil curve as the trefoil', () => {
    const result = recognise({ points: sample(trefoil), radius: 0.02 });
    expect(result.name).toBe('trefoil');
    expect(result.determinant).toBe(3);
    expect(result.crossings).toBe(3);
  });

  it('names the trefoil the same whichever way the rope is turned', () => {
    // A fixed seed, so the same 100 turns run every time.
    let seed = 11;
    const next = () => {
      seed = (seed * 16807) % 2147483647;
      return (seed / 2147483647) * Math.PI * 2;
    };
    for (let k = 0; k < 100; k++) {
      // One set of angles for the whole curve, so it is turned rigidly.
      const a = next();
      const b = next();
      const c = next();
      const turned = sample(trefoil).map((p) => turn(p, a, b, c));
      expect(recognise({ points: turned, radius: 0.02 }).name).toBe('trefoil');
    }
  });

  it('names the mirror image of the trefoil as the trefoil', () => {
    const result = recognise({ points: sample(mirroredTrefoil), radius: 0.02 });
    expect(result.name).toBe('trefoil');
  });
});
@}
